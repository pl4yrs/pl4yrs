# pl4yrs-backend as a system service. After installing:
#
#   systemctl daemon-reload
#   systemctl enable --now pl4yrs-backend
#
# Tunables in /etc/pl4yrs/backend.env (PL4YRS_BACKEND_PORT, SENDSPIN_CONFIG_FILE, SENDSPIN_SOCK).

[Unit]
Description=pl4y.rs backend and API service
Documentation=https://github.com/pl4yrs/pl4yrs
Wants=network-online.target
After=network-online.target
Requires=sendspin-cli.service
After=sendspin-cli.service

[Service]
Type=simple
User=pl4yrs

EnvironmentFile=-/etc/pl4yrs/backend.env
ExecStart=/usr/bin/pl4yrs-backend

Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# AF_UNIX for the sendspin control socket, AF_INET/6 for the HTTP API.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target

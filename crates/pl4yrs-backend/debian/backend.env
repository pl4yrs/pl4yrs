# Environment overrides for pl4yrs-backend.service. Uncomment to change.

# TCP port for the HTTP API.
#PL4YRS_BACKEND_PORT=4243

# Sendspin CLI config file read for the /config endpoint.
#SENDSPIN_CONFIG_FILE=/etc/sendspin-cli.conf

# Sendspin CLI control socket the player state is proxied from.
#SENDSPIN_SOCK=/var/run/sendspin-cli/control.sock
